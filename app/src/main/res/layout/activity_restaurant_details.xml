<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#123B5D"
            android:paddingHorizontal="18dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Restaurant Details"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Restaurant Hero Image -->
        <ImageView
            android:id="@+id/restaurantMainImage"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#DCE5EC"
            android:scaleType="centerCrop"
            android:src="@drawable/cox"
            android:contentDescription="Restaurant image" />

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/restaurantDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Palongki Restaurant"
                android:textColor="#123B5D"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/restaurantDetailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seafood • Bengali Cuisine"
                android:textColor="#718096"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/restaurantDetailRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="★ 4.3  |  Restaurant Rating"
                android:textColor="#D99A28"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/restaurantDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📍 Kolatoli, Cox's Bazar"
                android:textColor="#526477"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/restaurantDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="Enjoy delicious food and a comfortable dining experience."
                android:textColor="#526477"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Food Menu Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Food Menu"
                android:textColor="#123B5D"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popular Items"
                android:textColor="#8291A3"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Food Item 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/foodImage1"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:scaleType="centerCrop"
                android:src="@drawable/cox"
                android:contentDescription="Food image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/foodName1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seafood Platter"
                    android:textColor="#123B5D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodDescription1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fresh seafood selection"
                    android:textColor="#8291A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/foodPrice1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Price: Check with restaurant"
                    android:textColor="#24845C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Food Item 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/foodImage2"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:scaleType="centerCrop"
                android:src="@drawable/cox"
                android:contentDescription="Food image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/foodName2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grilled Fish"
                    android:textColor="#123B5D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodDescription2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Freshly grilled fish"
                    android:textColor="#8291A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/foodPrice2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Price: Check with restaurant"
                    android:textColor="#24845C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Food Item 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/foodImage3"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:scaleType="centerCrop"
                android:src="@drawable/cox"
                android:contentDescription="Food image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/foodName3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chicken Biryani"
                    android:textColor="#123B5D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodDescription3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Traditional aromatic rice"
                    android:textColor="#8291A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/foodPrice3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Price: Check with restaurant"
                    android:textColor="#24845C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Food Item 4: Orange Juice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/foodImage4"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:scaleType="centerCrop"
                android:src="@drawable/palongki_orange_juice"
                android:contentDescription="Orange Juice" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/foodName4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Orange Juice"
                    android:textColor="#123B5D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodDescription4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fresh orange juice"
                    android:textColor="#8291A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/foodPrice4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Price: Check with restaurant"
                    android:textColor="#24845C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>


        <!-- Booking Button -->
        <Button
            android:id="@+id/restaurantBookButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#123B5D"
            android:text="Book a Table"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
