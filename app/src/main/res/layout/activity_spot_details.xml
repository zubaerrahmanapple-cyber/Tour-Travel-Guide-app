<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- HERO IMAGE -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp">

            <ImageView
                android:id="@+id/spotMainImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/cox"
                android:contentDescription="Destination photograph" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000" />

            <TextView
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="24dp"
                android:background="#88000000"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/spotCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COX'S BAZAR"
                    android:textColor="#D8F7FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spotName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Laboni Beach"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spotLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cox's Bazar, Bangladesh"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>
        </FrameLayout>


        <!-- PHOTO GALLERY HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Photo Gallery"
                android:textColor="#123B5D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viewAllPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="View All Photos  →"
                android:textColor="#167D9A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- PHOTO GALLERY -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- PHOTO 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 1" />
                </androidx.cardview.widget.CardView>

                <!-- PHOTO 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 2" />
                </androidx.cardview.widget.CardView>

                <!-- PHOTO 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 3" />
                </androidx.cardview.widget.CardView>

                <!-- PHOTO 4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 4" />
                </androidx.cardview.widget.CardView>

                <!-- PHOTO 5 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 5" />
                </androidx.cardview.widget.CardView>

                <!-- PHOTO 6 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="190dp"
                    android:layout_height="130dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/galleryImage6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Gallery photograph 6" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ABOUT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:text="About This Place"
            android:textColor="#123B5D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spotDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:lineSpacingExtra="5dp"
            android:text="Discover the natural beauty of this destination, enjoy the coastal scenery and explore nearby attractions."
            android:textColor="#667681"
            android:textSize="14sp" />

        <!-- TRAVEL INFORMATION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:text="Travel Information"
            android:textColor="#123B5D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spotBestTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:padding="14dp"
            android:background="#E7F5F5"
            android:text="Best time to visit: Check local weather before travelling."
            android:textColor="#246B70"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/spotTravelTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:padding="14dp"
            android:background="#FFF1DF"
            android:text="Travel tip: Keep the beach clean and follow local safety instructions."
            android:textColor="#805C32"
            android:textSize="14sp" />

        <!-- BOOK BUTTON -->
        <Button
            android:id="@+id/bookNowButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="#123B5D"
            android:text="BOOK THIS DESTINATION"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
